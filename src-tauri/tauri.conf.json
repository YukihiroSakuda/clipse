{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipse",
  "version": "0.7.4",
  "identifier": "com.clipse.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Clipse",
        "width": 800,
        "height": 700,
        "visible": false,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/YukihiroSakuda/clipse/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFQzcyQkJENTFEMjNDRDIKUldUU1BOSlJ2U3ZIL2hwTWxvM2RRRS80ZlVWMG9JQVlYcVhVWnJHU3VuRjNHL1p3OHNURFl3SDEK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Yukihiro Sakuda",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "軽量スクリーンショット支援ツール",
    "longDescription": "ホットキーでスクリーンショットを撮影し、矢印・テキストなどの注釈を付けて共有できる軽量デスクトップツール。OCR機能でテキスト抽出も可能。",
    "license": "MIT",
    "copyright": "Copyright © 2026 Yukihiro Sakuda",
    "category": "Utility",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "compression": "lzma",
        "startMenuFolder": "Clipse"
      },
      "allowDowngrades": true
    }
  }
}
